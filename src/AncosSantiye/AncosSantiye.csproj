<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AncosSantiye</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ancos-santiye</ToolCommandName>
    <!-- dotnet run starts in the project folder by default; start where the user is, like the installed tool. -->
    <RunWorkingDirectory>$(MSBuildStartupDirectory)</RunWorkingDirectory>
    <PackageId>AncosSantiye</PackageId>
    <Version>0.1.0</Version>
    <Authors>Mehmet Esat Comlekci</Authors>
    <Description>Watch your AI coding agents build your project as a pixel art construction site.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Web SDK already picks up skin.json; remove it first so every skin file is listed once. -->
    <Content Remove="skins/**" />
    <Content Include="skins/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="wwwroot/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
